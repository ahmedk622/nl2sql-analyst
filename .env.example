# --- LLM (free tiers: Groq or Google AI Studio / Gemini) ---
LLM_PROVIDER=groq
LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# --- MySQL (the app uses a READ-ONLY user) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=analytics_demo
DB_USER=analyst_ro
DB_PASSWORD=ro_password_change_me

# Admin credentials, used ONLY by scripts/setup_db.py to create tables + the read-only user
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=your_mysql_root_password

# --- Safety / behaviour ---
MAX_ROWS=500
MAX_REPAIRS=2
